# Database
export DATABASE_URL=postgresql://mira:mira@localhost:5432/mira

# ---------------------------------------------------------------------------
# GitHub — pick ONE of: App mode (upstream) or PAT mode (personal fork)
# ---------------------------------------------------------------------------

# App mode (GitHub App install):
# export MIRA_GITHUB_APP_ID=123456
# export MIRA_GITHUB_PRIVATE_KEY_PATH=./private-key.pem
# export MIRA_GITHUB_PRIVATE_KEY="$(cat private-key.pem)"

# PAT mode (personal collaborator reviews — no App required):
# Create a fine-grained or classic PAT with repo + PR write access, add the
# bot user as a collaborator on each target repo, and point repo/org webhooks
# at https://<host>/github/webhook with the same secret below.
export MIRA_GITHUB_TOKEN=ghp_your_personal_access_token
# GITHUB_TOKEN is also accepted as a fallback alias for MIRA_GITHUB_TOKEN.

# Required for both App and PAT webhook verification (HMAC).
export MIRA_WEBHOOK_SECRET=your_webhook_secret_here

# Optional: GitHub Enterprise Server.
#   export MIRA_GITHUB_API_URL=https://github.acme-corp.com/api/v3
#   export MIRA_GITHUB_GRAPHQL_URL=https://github.acme-corp.com/api/graphql
# Optional: bot @mention override. Defaults to App slug or PAT user's login.
# export MIRA_BOT_NAME=nerd-miku

# ---------------------------------------------------------------------------
# LLM — OpenAI-compatible endpoints (set base_url + api_key_env in config YAML,
# or use env keys with matching provider profile defaults)
# ---------------------------------------------------------------------------

# OpenRouter (default)
export OPENROUTER_API_KEY=sk-or-v1-your-key-here
export MIRA_MODEL=anthropic/claude-sonnet-4-6

# Command Code Provider API (https://commandcode.ai/docs/provider)
# base_url: https://api.commandcode.ai/provider/v1
# export CMD_API_KEY=your_commandcode_key
# xAI Grok: either XAI_API_KEY, or run `mira login xai` once (token stored under MIRA_INDEX_DIR)
# export XAI_API_KEY=your_xai_key
# model example: deepseek/deepseek-v4-flash

# OpenCode Go (https://opencode.ai/docs/go/)
# base_url: https://opencode.ai/zen/go/v1
# export OPENCODE_API_KEY=your_opencode_key
# model example: kimi-k2.7-code  or  deepseek-v4-flash

# OpenCode Zen (pay-as-you-go; same OPENCODE_API_KEY)
# base_url: https://opencode.ai/zen/v1

# Dashboard
# Initial admin password. If unset, a random password is generated on first
# start and written to <MIRA_INDEX_DIR>/initial_admin_password (mode 0600).
# Never use a guessable value here.
# export ADMIN_PASSWORD=
export MIRA_INDEX_DIR=./data/indexes
