{
  "_comment": "Per-provider quirks for the OpenAI-compatible client, matched by base_url (fields documented in providers.py). Any endpoint with no entry here gets the portable default: bare model name, no extra headers, no reasoning remap. Override or extend via MIRA_PROVIDERS_JSON_PATH.",

  "openrouter": {
    "base_url": "https://openrouter.ai/api/v1",
    "api_key_env": "OPENROUTER_API_KEY",
    "model_prefix": "keep",
    "extra_headers": {
      "HTTP-Referer": "https://github.com/miracodeai/mira",
      "X-Title": "Mira Code Reviewer"
    },
    "reasoning_effort_map": { "max": "xhigh" }
  },

  "commandcode": {
    "base_url": "https://api.commandcode.ai/provider/v1",
    "api_key_env": "CMD_API_KEY",
    "model_prefix": "keep",
    "extra_headers": {},
    "reasoning_effort_map": {}
  },

  "xai": {
    "base_url": "https://api.x.ai/v1",
    "api_key_env": "XAI_API_KEY",
    "auth": "xai-oauth",
    "model_prefix": "strip",
    "extra_headers": {},
    "reasoning_effort_map": { "max": "high", "xhigh": "high" }
  },

  "opencode-go": {
    "base_url": "https://opencode.ai/zen/go/v1",
    "api_key_env": "OPENCODE_API_KEY",
    "model_prefix": "strip",
    "extra_headers": {},
    "reasoning_effort_map": {}
  },

  "opencode-zen": {
    "base_url": "https://opencode.ai/zen/v1",
    "api_key_env": "OPENCODE_API_KEY",
    "model_prefix": "strip",
    "extra_headers": {},
    "reasoning_effort_map": {}
  }
}
